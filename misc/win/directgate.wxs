<?xml version="1.0" encoding="utf-8"?>
<!--
    DirectGate Agent MSI installer (WiX Toolset v5).

    The WiX Toolset only runs on Windows, so the MSI is built in CI rather than
    the Linux release pipeline: see the build-msi job in
    .github/workflows/windows.yml. That job cross-checks the same self-contained
    binaries the native build produces, then runs WiX with these values supplied
    as preprocessor variables:
      $(var.Version)    - MSI ProductVersion (MAJOR.MINOR.BUILD from src/common/version.h)
      $(var.StageDir)   - directory holding directgate.exe / dgcli.exe plus the
                          staged README.md and LICENSE
      $(var.LicenseRtf) - path to the WixUI license page (misc/win/License.rtf)

    What it installs on the target machine:
      C:\Program Files\DirectGate\directgate.exe   (agent; also the service image)
      C:\Program Files\DirectGate\dgcli.exe        (CLI client)
      C:\Program Files\DirectGate\README.md, LICENSE
      C:\ProgramData\directgate\                    (machine-wide service config home)
    and adds the install dir to the system PATH.

    Service model (see docs/windows.md): the agent has native SCM support via the
    win-service flag. The service command line pins the config to
    C:\ProgramData\directgate\agent.json, because %APPDATA% (the interactive
    default, see src/agent/config.c) is unreliable under a service logon. Console
    use is unchanged and still defaults to %APPDATA%\directgate\agent.json.

    The service is installed Start=demand (manual) and is NOT started by the
    installer: the agent refuses to start unless shell.user in the config matches
    the service's run-as account, and the config must be paired first. The run-as
    account is collected by ServiceCredsDlg (or set on the msiexec command line).
    An empty account makes the MSI register the service as LocalSystem, which is
    inert here - the service stays stopped and the agent's identity check would
    refuse to run it unless shell.user == "SYSTEM".
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package
        Name="DirectGate Agent"
        Manufacturer="DirectGate"
        Version="$(var.Version)"
        UpgradeCode="aada7223-d00d-4a8f-88ac-d8b48f1ade30"
        Scope="perMachine"
        Compressed="yes"
        Language="1033">

        <MediaTemplate EmbedCab="yes" />

        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of DirectGate Agent is already installed." />

        <!--
            Service run-as account. Collected interactively by ServiceCredsDlg below,
            or supplied for silent installs:
              msiexec /i directgate-...-x64.msi SERVICEACCOUNT=.\Alice SERVICEPASSWORD=...
            Secure=yes so the value survives into the elevated (per-machine) execute
            sequence; Hidden=yes keeps the password out of the MSI log.
        -->
        <Property Id="SERVICEACCOUNT" Secure="yes" />
        <Property Id="SERVICEPASSWORD" Secure="yes" Hidden="yes" />

        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

        <Feature Id="Main" Title="DirectGate Agent" Level="1">
            <ComponentRef Id="CmpAgentExe" />
            <ComponentRef Id="CmpCliExe" />
            <ComponentRef Id="CmpDocs" />
            <ComponentRef Id="CmpPath" />
            <ComponentRef Id="CmpDataFolder" />
        </Feature>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="DirectGate">

                <Component Id="CmpAgentExe" Bitness="always64">
                    <File Id="FileAgentExe"
                          Source="$(var.StageDir)/directgate.exe"
                          KeyPath="yes" />

                    <ServiceInstall
                        Id="AgentSvc"
                        Name="directgate-agent"
                        DisplayName="DirectGate Agent"
                        Description="DirectGate secure remote agent."
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="[SERVICEACCOUNT]"
                        Password="[SERVICEPASSWORD]"
                        Arguments=" --win-service -c &quot;C:\ProgramData\directgate\agent.json&quot;"
                        Vital="no" />

                    <ServiceControl
                        Id="AgentSvcCtl"
                        Name="directgate-agent"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
                </Component>

                <Component Id="CmpCliExe" Bitness="always64">
                    <File Id="FileCliExe"
                          Source="$(var.StageDir)/dgcli.exe"
                          KeyPath="yes" />
                </Component>

                <Component Id="CmpDocs" Bitness="always64">
                    <File Id="FileReadme" Source="$(var.StageDir)/README.md" KeyPath="yes" />
                    <File Id="FileLicense" Source="$(var.StageDir)/LICENSE" />
                </Component>

                <!-- Add the install directory to the system PATH so directgate /
                     dgcli resolve from any console. Registry value is the keypath. -->
                <Component Id="CmpPath"
                           Guid="0673cbe8-c127-4730-9dc6-7ebe7082e74f"
                           Bitness="always64">
                    <Environment
                        Id="PathEnv"
                        Name="PATH"
                        Value="[INSTALLFOLDER]"
                        Part="last"
                        Action="set"
                        System="yes"
                        Permanent="no" />
                    <RegistryValue
                        Root="HKLM"
                        Key="Software\DirectGate\Agent"
                        Name="InstallDir"
                        Type="string"
                        Value="[INSTALLFOLDER]"
                        KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <!--
            Machine-wide config home for service mode. We only create the folder and
            leave the default ProgramData ACL in place: a non-admin can create files
            here (so pairing as the service account works), but cannot tamper with
            files owned by others. The agent additionally writes agent.json itself
            with a protected, 0600-equivalent DACL (see docs/windows.md), so a
            restrictive folder DACL is intentionally avoided - it would lock the
            service account out of reading its own config.
        -->
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Id="DataFolder" Name="directgate">
                <Component Id="CmpDataFolder"
                           Guid="fa07c2b9-145b-4d7a-a629-9e21ba66269e"
                           Bitness="always64">
                    <RegistryValue
                        Root="HKLM"
                        Key="Software\DirectGate\Agent"
                        Name="DataDir"
                        Type="string"
                        Value="[DataFolder]"
                        KeyPath="yes" />
                    <CreateFolder />
                </Component>
            </Directory>
        </StandardDirectory>

        <!-- ============================ UI ============================ -->
        <!--
            WixUI_InstallDir flow with one extra dialog (ServiceCredsDlg) spliced in
            between the install-directory and the confirm pages to collect the service
            run-as account. The UI authoring is kept in this Package element on
            purpose: a standalone <Fragment> would be dropped by the linker unless
            referenced, so embedding here guarantees it is included.
        -->
        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

        <UI>
            <Dialog Id="ServiceCredsDlg" Width="370" Height="270" Title="DirectGate Agent Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                         TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15"
                         Transparent="yes" NoPrefix="yes"
                         Text="{\WixUI_Font_Title}Windows service account" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15"
                         Transparent="yes" NoPrefix="yes"
                         Text="Choose the account the DirectGate service runs as." />

                <Control Id="Info" Type="Text" X="20" Y="60" Width="335" Height="52" NoPrefix="yes"
                         Text="The service runs directgate.exe with the config at C:\ProgramData\directgate\agent.json. Enter the Windows account it should run as (for example .\Alice); it must match shell.user in the paired config. Leave both fields blank to configure the service later - it is installed but stays stopped until you start it." />

                <Control Id="AccountLabel" Type="Text" X="20" Y="120" Width="200" Height="13"
                         NoPrefix="yes" Text="Account (DOMAIN\User or .\User):" />
                <Control Id="AccountEdit" Type="Edit" X="20" Y="134" Width="330" Height="16"
                         Property="SERVICEACCOUNT" />

                <Control Id="PasswordLabel" Type="Text" X="20" Y="160" Width="200" Height="13"
                         NoPrefix="yes" Text="Password:" />
                <Control Id="PasswordEdit" Type="Edit" X="20" Y="174" Width="330" Height="16"
                         Property="SERVICEPASSWORD" Password="yes" />

                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="InstallDirDlg" />
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg" />
                </Control>
            </Dialog>

            <!--
                Splice ServiceCredsDlg into the WixUI_InstallDir chain. Adding a
                higher-Order NewDialog publish overrides the built-in target because
                MSI applies the last satisfied NewDialog event in Ordering order.
            -->
            <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServiceCredsDlg"
                     Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServiceCredsDlg"
                     Order="5" Condition="NOT Installed" />
        </UI>
    </Package>
</Wix>
