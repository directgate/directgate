/* Windows resources for the DirectGate CLI client (dgcli.exe):
   the application manifest plus version / company metadata. Compiled by
   windres (MinGW) or rc.exe and linked into the binary. */

#include "common/version.h"

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST. The manifest
   selects the UTF-8 active code page so the ANSI APIs handle any file name. */
1 24 "directgate.manifest"

/* Build "MAJOR.MINOR.BUILD.0" from the numeric macros in version.h. Adjacent
   string-literal concatenation is the standard Windows version-resource idiom. */
#define DG_STR2(x) #x
#define DG_STR(x)  DG_STR2(x)
#define DG_VERSION_STRING \
    DG_STR(DIRECTGATE_VERSION_MAJOR) "." \
    DG_STR(DIRECTGATE_VERSION_MINOR) "." \
    DG_STR(DIRECTGATE_VERSION_BUILD) ".0"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    DIRECTGATE_VERSION_MAJOR,DIRECTGATE_VERSION_MINOR,DIRECTGATE_VERSION_BUILD,0
    PRODUCTVERSION DIRECTGATE_VERSION_MAJOR,DIRECTGATE_VERSION_MINOR,DIRECTGATE_VERSION_BUILD,0
    FILEFLAGSMASK  0x3fL
    FILEFLAGS      0x0L
    FILEOS         0x40004L   /* VOS_NT_WINDOWS32 */
    FILETYPE       0x1L       /* VFT_APP */
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   /* US English (0x0409), Unicode (1200 / 0x04b0) */
        BEGIN
            VALUE "CompanyName",      "DirectGate"
            VALUE "FileDescription",  "DirectGate CLI"
            VALUE "FileVersion",      DG_VERSION_STRING
            VALUE "InternalName",     "dgcli"
            VALUE "LegalCopyright",   "Copyright (c) 2025-2026 DirectGate"
            VALUE "OriginalFilename", "dgcli.exe"
            VALUE "ProductName",      "DirectGate"
            VALUE "ProductVersion",   DG_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
